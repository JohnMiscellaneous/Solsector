{
    ## 0 disables the remnants entirely
    ## 1 Fills the inner system with weak remnants
    ## 2 Fills the inner system with remnants
    ## 3 Fills the system with a massive amount of renmnant nexuses and death fleets.
    "remnant_difficulty": 1,

    ## Planets will be settled by various factions
    ## the settled planets will appear upon jump into the Sol system
    "Generate_Settled_Planets": true,

    ## this dictates if the settled planets should intialise on game load or on entry to Sol
    "Settled_Planets_Spawn_In_Instantly": false,

    ## 0 disables all minor planet names
    ## 1 disables all minor planet names (bar textured custom entities), (DEFAULT)
    ## 2 disables provisional names, 
    ## 3 shows all names
    "Show_Names": 1,

    ## what is the AD start date,
    ## dictates planet starting position.
    "Current_Year": 10005,

    ## ======= Sector Position =============================

    "X-coord": 75000,
    "Y-coord": 42000,

    ## if settings or wide horizons changes map size, this means it will remain in the same position
    "Scale_With_Map_Size": true,
    ## overides the prior settings and makes sol random
    "Random_Location": false,
    ## with industrial evolution spawns several artillery stations, even if the eye bugs out
    "Several_Artillery_Stations": true,

    ## disables some of the more memey things
    "Trans_Neptunian_Memes": false,

    ## ======================================================
    ## ======= What entities to generate? ===================
    ## ======================================================

	"Generate_Sol": true,   

    ## enables or disables some less interesting NEAs
    ## accepted values 0, 1    
    "Inner_Sol_Detail": 0,

    ## enables or disables some small Visited Asteroids
    ## accepted values 0, 1
    "Visited_Asteroids_Detail": 0, 

    ## enables or disables some less important/interesting asteroids
    ## accepted values 0, 1
    "Asteroid_Detail": 0,

    ## you get the point
    ## accepted values 0, 1
    "Hilda_Detail": 0,

    ## number of generic asteroid belt asteroids to generate
    "Generic_Asteroids": 10,

    ## accepted values 0, 1, 2
    "Jupiter_Trojans_Detail": 1,

    ## 0 - galilean moons, inner moons, and a few irregulars (default)
    ## 1 - adds some more irregulars
    ## 2 - adds EVERY irregular (not recommended)
    "Jupiter_Detail": 0,

    ## 0 - inner moons, and a few irregulars (default)
    ## 1 - adds some more inner moons and irregulars
    ## 2 - adds EVERY irregular (VERY not recommended)
    "Saturn_Detail": 0,

    ## accepted values 0, 1,   
    "Uranus_Detail": 0,

    ## accepted values 0, 1       
    "Neptune_Detail": 0,

    ## accepted values 0, 1,      
    "Neptune_Trojans_Shortlist": 1,

    ## accepted values 0, 1,      
    "Centaur_Shortlist": 0,

    ## accepted values 0, 1,  
    "Kuiper_Detail": 1,
    
    ## accepted values 0, 1,  
    "Scattered_Disk_Detail": 1,

    ## 0 - just major ones (default)
    ## 1 - adds minor stable langranges
    ## 2 - add l3
    "Stable_Points_Detail": 0,

    ## A few asteroids from science fiction which A, I respect, and B, has the grace to include a minor TNO or Jovian Irreg
    "Fictional_Trans_Neptunian_Objects": true,

    ## 0 is only the confirmed planets (default)
    ## 1 adds planet 9 (the famous pocket ice giant)
    ## 2 adds planet 10 (a mercury-mars sized scattered disk object)
    ## 3 adds Sean N. Raymond's 7% chance oort ice giant 
    "Speculative_Bodies_Big": 1,

    ## 0 is confirmed moons only, (default)
    ## 1 is convincing speculative moons, 
    ## 2 is edge-case speculative moons
    "Speculative_Bodies": 0,

    ## 0 is no deep space probes
    ## 1 is a few deep space probes (default)
    ## 2 is pretty much every probe that could last thousands of years and is not on a bassically earth orbit
    "Generate_Probes": 1,

    ## MISC ===============================================

    ## disable if you dont like the elevator custom entities
    "Generate_Space_Elevators": true,

    ## probably most interested in Sol, but I don't like the gameplay impact
    "Luddic_Church_Claim_On_Sol": false,

    ## Mercury gets poor light and very cold because of its near locking and no heat distribution, venus gets poor light because of its near locking, Eros gets cold and hot because of its 90 degree axial tilt
    "Mercury_And_Venus_Have_Poor_Light": true,

    ## Uranus and Neptune's 'surface gravity' is earth like, and throughout their 3d geometry remains close to earth, removes high gravity after hyperspace so that the gravity wells exist but not the hazard.
    "Uranus_And_Neptune_Have_Normal_Gravity": true,

    ## ======================================================
    ## =============== ORBIT & SIZE STUFF ===================
    ## ======================================================
    ## Settings you might edit

    ## enables custom orbits, great for performance, if it doesn't make you crash
    "Occult_Orbit_Beta": true,
    ## defines if the logic should be circular or eccentric (if Occultorbitbeta should be false ), 1 will force everthing to being circular
    "Eccentricity_Cutoff": 0.01,
    
    ## if occultOrbitBeta == true, 'pins' some bodies to other bodies so the intel screen doesn't bug out, orbitally they act the same but Vesta registers as a moon of Ceres, etc
    ## causes AOTD's system veiewer to be weird, so its a tradeoff
    "False_Moons": true,

    ## farfarout is 2x sedna which is 2x pluto which is 2x uranus which is 2x saturn which is 2x jupiter which is 2x vesta which is 2x mars which is 2x earth which is 2x mercury (roughly)
    ## 140 / 2^9 = .3
    ## the solar system cannot be relaibly represented linearly
    "Linear_Distance": false,   

    ## 0 = false
    ## 1 = true with adjustments for log distance and gas giant inners (default)
    ## 2 = true 
    "Linear_Time": 1,   
    "Linear_Size": false,   
    ## requires linear Size, takes precedent over to scale, converts gas giant distances to in AU to km
    "To_Scale_Gas_Giant": false,
    ## requires linear distance, does as says, highly inadvisable, will break
    "To_Scale": false,

    ## extComp(log(intComp * AU + 1)) + Lin * AU
    "extComp": 10000, "intComp": 0.5, "distLinMod": 50,

    "distMax": 1000000,

    ## progradeMult * timeExt(log(timeInt * days + 1)) + Lin * AU
    "timeExt": 120000,
    "timeInt": 0.000019,
    "timeLinMod": 1,

    "giantTimeExt": 10,
    "giantTimeInt": 0.8,

    "progradeMult": -1,

    ## Bad math warning
    ## ext(log(int * km + 1)) + (sqrt(km) / 1 + (sizeDenom * km)) + sizeConst + Lin * Km
    "sizeExt": 200,
    "sizeInt": 0.00005,
    "sizeDenom": 0.0005,
    "sizeConst": 5 ,
    "sizeLinMod": 0.001,

    "rotDenom":4,
}
